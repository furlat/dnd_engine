    "summoning_body_review": {
      "date": "2026-10-03",
      "source_variant": "Blue Raptor",
      "direction_evidence": "Named original Idle frames exactly match all eight atlas rows.",
      "timing": "15 original samples at authored 12 FPS. The PNG packs provide no FPS, pivot or event markers. Contact/recovery frames below are reviewed execution choices.",
      "ground_pivot": {
        "x": 32.0,
        "y": 44,
        "evidence": "Authored from paired Idle shadow footprint and all eight support views; image bounds are not the ground plane."
      },
      "shadow_policy": "Recoverable original shadow pixels from exact With shadow + Shadowless pairs; original alpha is preserved at rig shadow_alpha 1. Opaque body pixels match the source composite exactly and hide an unrecoverable region, left transparent rather than invented. Recomposition with the original opaque body reproduces all visible source RGBA and all alpha exactly. Shadow is independent of body/Fey palette and body lift.",
      "attacks": {
        "blue_raptor_claws": {
          "source_clip": "Raptor Attack1",
          "contact_frame": 6,
          "recover_frame": 11,
          "motion": "Forward forelimb/body thrust at 6, using the approved primary strip."
        },
        "blue_raptor_bite": {
          "source_clip": "Raptor Attack2",
          "contact_frame": 7,
          "recover_frame": 11,
          "motion": "Head rises then jaws extend at 7."
        }
      },
      "outcomes": "Hit, miss, critical, opportunity and native Multiattack children select the same explicit anatomical row. One emitted attack fact owns one contact; art turns and repeated swipes create no extra native hits. Separate AttackVfx tracks are explicitly empty.",
      "movement": "Run owns the gait only. Native recorded path/height owns displacement. Jump uses Run as an explicitly normalized airborne gallop adaptation. Window uses Run with its own frame keys and existing connector passage scale.",
      "flight": "No flying native capability is granted by this binding.",
      "prone": "Intact non-exploding fall, explicit frame-14 living rest pose, reverse stand-up. Death continues to use the compatible shared death owner; summoned departure is separate.",
