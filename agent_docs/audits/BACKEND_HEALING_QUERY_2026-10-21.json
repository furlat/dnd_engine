  "reproduction_script": "import json\nfrom pathlib import Path\nfrom time import perf_counter\nfrom dnd.content_system.bootstrap import bootstrap_content_system\nfrom dnd.content_system.runtime import SERVER_CONTENT_SYSTEM_RUNTIME\nfrom dnd.actions_functional import get_available_actions, free_aim_target, preview_available_selection\nfrom dnd.core.creature_types import DamageType\nfrom dnd.core.dice import fixed_dice_faces\nfrom dnd.player.commands import ActionSelection\nfrom tests.player.test_zero_hp_healing import healing_scene\nfrom tests.player.test_compact_choices import world, request_choices, rows\nfrom tests.player.test_handoff_discovery_regressions import submit\n\nSERVER_CONTENT_SYSTEM_RUNTIME.install(bootstrap_content_system())\nfixture=healing_scene.__wrapped__()\ncaster,patient=next(fixture)\ntry:\n for state in ('healthy','stable'):\n  if state=='stable':\n   patient.receive_damage(patient.get_normal_hp(),DamageType.FORCE,caster.uuid)\n   patient.stabilize()\n  for sample in range(13):\n   started=perf_counter()\n   available=get_available_actions(caster,include_aoe_preview=False)\n   end=perf_counter()\n   row=next(r for r in available.all_actions if r.behavior_id=='spell.mass_cure_wounds')\n   target=free_aim_target(row,patient.position)\n   preview_start=perf_counter()\n   preview=preview_available_selection(caster,row,(target,),cast_at_level=5)\n   preview_end=perf_counter()\n   print(json.dumps(dict(case='cleric_'+state,sample=sample,warmup=sample==0,discovery_ms=(end-started)*1000,preview_ms=(preview_end-preview_start)*1000,patient_in_preview=patient.uuid in preview.affected_entity_uuids)),flush=True)\nfinally: fixture.close()\nfor sample in range(7):\n fixture=world.__wrapped__(Path('/unused-memory-only-configuration'))\n runtime,seat,publication=next(fixture)\n try:\n  actor=runtime.session.game.entities[publication.boundary.input_actor_uuid]\n  discovered=request_choices((runtime,seat,publication)).choices\n  row=next(r for r in rows(discovered) if r.behavior_id=='spell.fireball')\n  enemy=next(e for e in runtime.session.game.entities.values() if actor.is_enemy(e))\n  selection=ActionSelection(row.discovery_index,(),extra_target_positions=(enemy.position,),cast_at_level=3)\n  with fixed_dice_faces(*([2]*200)):\n   started=perf_counter()\n   records=submit(runtime,seat,actor,discovered,selection,1)\n   end=perf_counter()\n  print(json.dumps(dict(case='fireball_worker_command',sample=sample,warmup=sample==0,total_ms=(end-started)*1000,records=len(records))),flush=True)\n finally: fixture.close()\n",
