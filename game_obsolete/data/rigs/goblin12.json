    "adaptation": {
      "timing": "12 FPS and release/contact markers are authored adaptations, not vendor metadata.",
      "scale": "1.00; complete original 128px cells, source body and shadow remain byte-for-byte.",
      "ground": "Body support is (64,87), or (64,69) for single-combatant riders. Prone/death depth uses measured original shadow centroids.",
      "effects": "Only nonempty caster accents and Goblin17 muzzle flash are clip-owned original layers. They cause no gameplay effects.",
      "neutral_actions": "Shared body contexts retain Idle for interactions without source gestures. Non-winged Fly holds Idle with shared magical lift."
    }
